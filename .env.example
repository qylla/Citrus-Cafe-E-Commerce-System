# Copy this file to .env and fill it in. Never commit .env.
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=dbcitruscafe_api
DB_USERNAME=root
DB_PASSWORD=

# Leave SENDGRID_API_KEY empty to turn receipt emails off.
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Citrus Cafe

# Long random value for outside systems that call api/addOrders.php.
# Leave empty to turn that endpoint off.
ORDER_API_KEY=
